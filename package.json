{
  "name": "vanilla-timezone-validation",
  "version": "1.0.4",
  "description": "A lightweight, zero-dependency, and tree-shakable library for validating IANA timezone strings via the native Intl API, including non-canonical (link) names.",
  "author": "Roman Kozodoi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Roman86/vanilla-timezone-validation.git"
  },
  "homepage": "https://github.com/Roman86/vanilla-timezone-validation#readme",
  "bugs": {
    "url": "https://github.com/Roman86/vanilla-timezone-validation/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "prepublishOnly": "git diff --quiet && git diff --staged --quiet && npm run lint && npm run test && npm run build",
    "build": "tsup src/index.ts --format cjs,esm --dts --minify --clean",
    "test": "jest",
    "lint": "biome lint ./src",
    "format": "biome format --write ./src"
  },
  "keywords": [
    "timezone",
    "timezones",
    "timezone-validation",
    "iana",
    "tz",
    "tzdata",
    "intl",
    "validation",
    "type-guard",
    "canonical-timezone",
    "zero-dependency",
    "datetime"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.3.4",
    "@types/jest": "^29.5.12",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.3",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  }
}
